# Salin ke file ini & ubah sesuai kebutuhan. Baris dengan # diabaikan.
# Env OS yang sudah di-set lebih diutamakan daripada file ini.

PAPER=true
PAIR=btc_idr
SIGNAL_SYMBOL=BTCUSDT
INTERVAL=1h

# Manajemen risiko
CUT_LOSS_PCT=3.0
TAKE_PROFIT_PCT=6.0
BUDGET_IDR=1000000
POLL_SECONDS=30

# Mode pair & sinyal dari screener
PAIR_MODE=auto
SCAN_MIN_SCORE=6
SCAN_SELL_SCORE=0
SCAN_MIN_VR=1.0
SCAN_MIN_VOL=300000000
SCAN_REFRESH=3600

# Live mode (PAPER=false) — wajib diisi, jangan commit file ini ke repo
#INDODAX_KEY=
#INDODAX_SECRET=

# Opsional
#MIN_ORDER_IDR=10000
#FEE_TAKER=0.002
